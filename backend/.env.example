# ─────────────────────────────────────────────────────────────────────────────
#  Smart Journey — Backend Environment Variables
#  Copy this file to .env and fill in your actual keys before running.
#  The MCP tool server reads this same file.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM providers (at least one key is required) ─────────────────────────────
# Gemini — primary: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional fallbacks, tried in this order when the primary model fails
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GEMINI_API_KEY_FALLBACK=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Matches the database started by docker-compose.yml
DATABASE_URL=postgresql+asyncpg://tripplanner:tripplanner123@localhost:5432/tripplanner_db

# ── Weaviate vector memory (optional — disabled if unreachable) ──────────────
WEAVIATE_URL=http://localhost:8080
# Leave empty for the local Docker instance (it allows anonymous access)
WEAVIATE_API_KEY=

# ── Search ───────────────────────────────────────────────────────────────────
# SerpAPI (Google Flights / Google Local): https://serpapi.com
SERPAPI_KEY=

# ── Currency (optional) ──────────────────────────────────────────────────────
# Fixer (tried first): https://fixer.io
FIXER_API_KEY=
# ExchangeRate-API (fallback): https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=

# ── Images (optional) ────────────────────────────────────────────────────────
# Unsplash destination photos: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
# Signs login tokens — set a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
